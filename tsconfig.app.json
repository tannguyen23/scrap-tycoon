{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Layer aliases — enforced by dependency-cruiser */
    "paths": {
      "@core/*": ["./src/core/*"],
      "@ground/*": ["./src/ground/*"],
      "@domain/*": ["./src/domain/*"],
      "@content/*": ["./src/content/*"],
      "@ui/*": ["./src/ui/*"],
      "@platform/*": ["./src/platform/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@app/*": ["./src/app/*"]
    },

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests"]
}
