{
  "name": "scrap-tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:studio": "vite --config vite.studio.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
